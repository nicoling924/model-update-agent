# ---- Model Update Agent, PC edition -------------------------------
# Copy to .env in the repo root (setup-windows.bat does this for you).

# The locally-synced SharePoint folder (sync it once in the browser:
# SharePoint library > Sync, then it appears under this kind of path).
WATCH_DIR=C:\Users\<you>\<Company>\ModelUpdateAgent - Documents

# Brain: relay = Copilot Studio's built-in GPT answers through
# WATCH_DIR\relay (no API key ever leaves the machine).
LLM_MODE=relay

# --- OR, if an external API key is allowed on this machine, use: ---
# LLM_MODE=api
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=openai/gpt-5.6-luna
