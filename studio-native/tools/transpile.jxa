// Strip TypeScript types using the real TS compiler, on JavaScriptCore.
// Usage: osascript -l JavaScript transpile.jxa <typescript.js> <in.ts> <out.js>
ObjC.import('Foundation')
function readFile(p) {
  return ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(
    p, $.NSUTF8StringEncoding, null))
}
function writeFile(p, s) {
  $(s).writeToFileAtomicallyEncodingError(p, true, $.NSUTF8StringEncoding, null)
}
function run(argv) {
  eval(readFile(argv[0]));               // defines `ts`
  const src = readFile(argv[1]);
  const out = ts.transpileModule(src, {
    compilerOptions: { target: ts.ScriptTarget.ES2020 }
  }).outputText;
  writeFile(argv[2], out);
  return "transpiled -> " + out.length + " chars";
}
